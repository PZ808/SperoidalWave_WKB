Cell[BoxData[{
 RowBox[{
  RowBox[{"nn", "[", 
   RowBox[{"u_", ",", "m_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{
    RowBox[{"-", 
     SqrtBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"u", "-", "1"}], ")"}], "2"], "+", 
       RowBox[{"4", " ", "m"}]}]]}], "+", "u", "-", "1"}], 
   RowBox[{
    RowBox[{"-", 
     SqrtBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"u", "-", "1"}], ")"}], "2"], "+", 
       RowBox[{"4", " ", "m"}]}]]}], "+", "u", "-", "1", "-", 
    RowBox[{"2", "m"}]}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kk", "[", 
   RowBox[{"u_", ",", "m_"}], "]"}], ":=", 
  SqrtBox[
   FractionBox[
    RowBox[{"u", "+", "1", "-", 
     SqrtBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"u", "-", "1"}], ")"}], "2"], "+", 
       RowBox[{"4", " ", "m"}]}]]}], 
    RowBox[{"u", "+", "1", "+", 
