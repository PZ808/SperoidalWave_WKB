   RowBox[{
    RowBox[{"Ord", "=", "8"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Ordhb", "=", "7"}], ";", "\[IndentingNewLine]", 
    RowBox[{"kseries", "=", 
     RowBox[{"Normal", "@", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"Series", "[", 
