Cell[BoxData[
 RowBox[{
  RowBox[{"PoleReduceDivisor", "[", 
   RowBox[{"poly_", ",", 
    RowBox[{"{", 
     RowBox[{"gbf_", ",", "Cf_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"gbD_", ",", "CD_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"f_", ",", "fpoly_"}], "}"}], ",", 
