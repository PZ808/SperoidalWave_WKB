            RowBox[{"2", "Ord"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"m", ">", "0"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"PiSeries", "=", 
     RowBox[{"Normal", "@", 
      RowBox[{"Series", "[", 
