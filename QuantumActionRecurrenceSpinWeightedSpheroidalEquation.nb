Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"PoleReducePair", "[", 
    RowBox[{"poly_", ",", 
     RowBox[{"{", 
      RowBox[{"gbf_", ",", "Cf_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"gbD_", ",", "CD_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"f_", ",", "fpoly_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalDelta]_", ",", "\[CapitalDelta]poly_"}], "}"}], ",", 
     "xs_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"JacD", ",", "p1", ",", "p2", ",", "q", ",", "r", ",", "q1"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"JacD", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"\[CapitalDelta]poly", ",", "xi"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"xi", ",", "xs"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"p1", "=", 
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"poly", ",", "f", ",", "0"}], "]"}], "+", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"poly", ",", "f", ",", "1"}], "]"}], " ", "f"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"p2", "=", 
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"poly", "-", "p1"}], "]"}], "//", "Expand"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", ",", "r"}], "}"}], "=", 
       RowBox[{"Simplify", "@", 
        RowBox[{"PolynomialReduce", "[", 
         RowBox[{"p2", ",", "gbf", ",", "xs"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q1", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"q", ".", "Cf"}], ")"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"xs", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "@", "xs"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q1", "=", 
       RowBox[{"CoefficientList", "[", 
        RowBox[{
         RowBox[{"q1", " ", "-", " ", 
          RowBox[{
           SuperscriptBox["\[CapitalDelta]", "2"], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"JacD", ".", 
              RowBox[{"(", 
               RowBox[{"q", ".", "Cf"}], ")"}]}], ",", "\[CapitalDelta]"}], 
            "]"}]}]}], ",", "f"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"q1", "=", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{"q1", "[", 
             RowBox[{"[", "i", "]"}], "]"}], 
            RowBox[{"i", "-", "2"}]], 
           SuperscriptBox["f", 
            RowBox[{"i", "-", "2"}]]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "3", ",", 
            RowBox[{"Length", "[", "q1", "]"}]}], "}"}]}], "]"}], "+", "p1", 
        "+", "r"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Total", "@", 
       RowBox[{"Simplify", "@", 
        RowBox[{"MonomialList", "[", 
         RowBox[{
          RowBox[{"FullSimplifyPoles", "[", 
           RowBox[{"q1", ",", 
            RowBox[{"{", 
             RowBox[{"\[CapitalDelta]", ",", "\[CapitalDelta]poly"}], "}"}], 
            ",", "xs"}], "]"}], ",", 
          RowBox[{"Join", "[", 
           RowBox[{"xs", ",", 
            RowBox[{"{", 
             RowBox[{"f", ",", "\[CapitalDelta]"}], "}"}]}], "]"}]}], 
         "]"}]}]}]}]}], "\[IndentingNewLine]", "]"}]}]}]], "Input",
