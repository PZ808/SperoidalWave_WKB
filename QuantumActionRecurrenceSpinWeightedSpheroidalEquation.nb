     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Jacf", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"fpoly", ",", "xi"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"xi", ",", "xs"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p1", "=", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"poly", ",", "\[CapitalDelta]", ",", "0"}], "]"}], "+", 
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"poly", ",", "\[CapitalDelta]", ",", "1"}], "]"}], " ", 
        "\[CapitalDelta]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p2", "=", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"poly", "-", "p1"}], "]"}], "//", "Expand"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"q", ",", "r"}], "}"}], "=", 
      RowBox[{"Simplify", "@", 
       RowBox[{"PolynomialReduce", "[", 
        RowBox[{"p2", ",", "gbD", ",", "xs"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q1", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{
