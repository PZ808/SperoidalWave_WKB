Cell[BoxData[
 RowBox[{
  RowBox[{"PoleReduceDivisor", "[", 
   RowBox[{"poly_", ",", 
    RowBox[{"{", 
     RowBox[{"gbf_", ",", "Cf_"}], "}"}], ",", 
