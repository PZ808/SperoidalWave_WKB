       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"poly", ",", "\[CapitalDelta]", ",", "1"}], "]"}], " ", 
        "\[CapitalDelta]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p2", "=", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"poly", "-", "p1"}], "]"}], "//", "Expand"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
