Cell[BoxData[
 RowBox[{
  RowBox[{"SimplifyPoles", "[", 
   RowBox[{"poly_", ",", 
    RowBox[{"{", 
     RowBox[{"\[CapitalDelta]_", ",", "\[CapitalDelta]poly_"}], "}"}], ",", 
    "xs_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"qr", ",", "p1", ",", "p2"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"p1", "=", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"poly", ",", "\[CapitalDelta]", ",", "0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p2", "=", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"poly", "-", "p1"}], "]"}], "//", "Expand"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qr", "=", 
      RowBox[{
       RowBox[{"PolynomialReduce", "[", 
        RowBox[{"p2", ",", "\[CapitalDelta]poly", ",", "xs"}], "]"}], "//", 
       "Flatten"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"p1", "+", 
      RowBox[{"qr", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "+", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"qr", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "/", "\[CapitalDelta]"}], 
       "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
