       RowBox[{"PolynomialReduce", "[", 
        RowBox[{"p2", ",", "gbD", ",", "xs"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q1", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"D", "[", 
