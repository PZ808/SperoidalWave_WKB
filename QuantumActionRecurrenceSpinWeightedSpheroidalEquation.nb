             RowBox[{"u", ",", "m", ",", 
              RowBox[{"Ord", "+", "1"}]}], "}"}]}], "]"}], "-", " ", 
          RowBox[{"2", 
           SqrtBox["2"], 
           SqrtBox["m"], " ", "\[Pi]"}]}], ",", 
         RowBox[{"m", ">", "0"}]}], "]"}]}], "//", "FullSimplify"}]}], ";", 
