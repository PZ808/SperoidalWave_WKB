    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"termslist", "=", 
      RowBox[{"Simplify", "@", 
       RowBox[{"GroebnerBasis`DistributedTermsList", "[", 
        RowBox[{"poly", ",", "vars"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"mons", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Times", "@@", 
