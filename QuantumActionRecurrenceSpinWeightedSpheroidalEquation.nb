Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"FullSimplifyPoles", "[", 
    RowBox[{"poly_", ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalDelta]_", ",", "\[CapitalDelta]poly_"}], "}"}], ",", 
     "xs_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pin", ",", "pout"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pin", "=", "poly"}], ";", "\[IndentingNewLine]", 
      RowBox[{"pout", "=", 
       RowBox[{"SimplifyPoles", "[", 
        RowBox[{"pin", ",", 
         RowBox[{"{", 
          RowBox[{"\[CapitalDelta]", ",", "\[CapitalDelta]poly"}], "}"}], ",",
          "xs"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"pin", "!=", "pout"}], ";", "\[IndentingNewLine]", 
        RowBox[{"pin", "=", "pout"}], ";", "\[IndentingNewLine]", 
        RowBox[{"pout", "=", 
         RowBox[{"SimplifyPoles", "[", 
          RowBox[{"pin", ",", 
           RowBox[{"{", 
            RowBox[{"\[CapitalDelta]", ",", "\[CapitalDelta]poly"}], "}"}], 
           ",", "xs"}], "]"}]}], ";"}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", "pout"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SimplifyPolynomial", "[", 
   RowBox[{"poly_", ",", "vars_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
