Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
      "a", " ", "function", " ", "needed", " ", "for", " ", 
       "\"\<conversionMatrix\>\"", " ", "found", " ", "below", " ", "found", 
       " ", "on", " ", "mathematica", " ", "archive"}], "..."}], " ", "see", 
     " ", 
     RowBox[{"https", ":"}]}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"library", ".", "wolfram", ".", "com"}], "/", "infocenter"}], 
       "/", "MathSource"}], "/", "7523"}], "/"}]}], "  ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"moduleGroebnerBasis", "[", 
      RowBox[{
      "polys_", ",", " ", "vars_", ",", " ", "cvars_", ",", " ", "opts___"}], 
      "]"}], " ", ":=", " ", "\n", "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"newpols", ",", " ", "rels", ",", " ", 
         RowBox[{"len", " ", "=", " ", 
          RowBox[{"Length", "[", "cvars", "]"}]}], ",", " ", "gb", ",", " ", 
         "j", ",", " ", "k", ",", " ", "rul"}], "}"}], ",", " ", "\n", "   ", 
       
       RowBox[{
        RowBox[{"rels", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"cvars", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "*", 
             RowBox[{"cvars", "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"j", ",", " ", "len"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"k", ",", " ", "j", ",", " ", "len"}], "}"}]}], "]"}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"newpols", " ", "=", " ", 
         RowBox[{"Join", "[", 
          RowBox[{"polys", ",", " ", "rels"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"gb", " ", "=", " ", 
         RowBox[{"GroebnerBasis", "[", 
          RowBox[{"newpols", ",", " ", 
           RowBox[{"Join", "[", 
            RowBox[{"cvars", ",", " ", "vars"}], "]"}], ",", " ", "opts"}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"rul", " ", "=", " ", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"#", " ", ":>", " ", 
              RowBox[{"{", "}"}]}], ")"}], " ", "&"}], ",", " ", "rels"}], 
          "]"}]}], ";", "\n", "   ", 
        RowBox[{"gb", " ", "=", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"gb", " ", "/.", " ", "rul"}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"Collect", "[", 
         RowBox[{"gb", ",", " ", "cvars"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
       "a", " ", "function", " ", "to", " ", "compute", " ", "a", " ", 
        "groebner", " ", "basis", " ", "and", " ", "conversion", " ", 
        RowBox[{"matrix", ".", " ", "found"}], " ", "on", " ", "mathematica", 
        " ", "archive"}], "..."}], " ", "see", " ", 
      RowBox[{"https", ":"}]}], "//", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"library", ".", "wolfram", ".", "com"}], "/", "infocenter"}],
         "/", "MathSource"}], "/", "7523"}], "/"}]}], "  ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"conversionMatrix", "[", 
      RowBox[{"polys_", ",", " ", "vars_"}], "]"}], " ", ":=", " ", "\n", 
     "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"aa", ",", " ", "coords", ",", " ", "pmat", ",", " ", 
         RowBox[{"len", " ", "=", " ", 
          RowBox[{"Length", "[", "polys", "]"}]}], ",", " ", "newpolys", ",", 
         " ", "mgb", ",", " ", "gb", ",", " ", "\n", "    ", "convmat", ",", 
         " ", "fvar", ",", " ", "rvars"}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"coords", " ", "=", " ", 
         RowBox[{"Array", "[", 
          RowBox[{"aa", ",", " ", 
           RowBox[{"len", " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", "   ", 
        RowBox[{"fvar", " ", "=", " ", 
         RowBox[{"First", "[", "coords", "]"}]}], ";", "\n", "   ", 
        RowBox[{"rvars", " ", "=", " ", 
         RowBox[{"Rest", "[", "coords", "]"}]}], ";", "\n", "   ", 
        RowBox[{"pmat", " ", "=", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", "polys", "}"}], ",", " ", 
            RowBox[{"IdentityMatrix", "[", "len", "]"}]}], "]"}], "]"}]}], 
        ";", "\n", "   ", 
        RowBox[{"newpolys", " ", "=", " ", 
         RowBox[{"pmat", " ", ".", " ", "coords"}]}], ";", "\n", "   ", 
        RowBox[{"mgb", " ", "=", " ", 
         RowBox[{"moduleGroebnerBasis", "[", 
          RowBox[{"newpolys", ",", " ", "vars", ",", " ", "coords"}], "]"}]}],
         ";", "\n", "   ", 
        RowBox[{"gb", " ", "=", " ", 
         RowBox[{
          RowBox[{"mgb", " ", "/.", " ", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"fvar", " ", "->", " ", "1"}], "}"}], ",", " ", 
             RowBox[{"Thread", "[", 
              RowBox[{"rvars", " ", "->", " ", "0"}], "]"}]}], "]"}]}], " ", "/.",
           " ", "\n", "     ", 
          RowBox[{"0", " ", ":>", " ", 
           RowBox[{"Sequence", "[", "]"}]}]}]}], ";", "\n", "   ", 
        RowBox[{"convmat", " ", "=", " ", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"mgb", ",", " ", 
            RowBox[{
             RowBox[{"!", " ", 
              RowBox[{"FreeQ", "[", 
               RowBox[{"#", ",", " ", "fvar"}], "]"}]}], " ", "&"}]}], "]"}], 
          " ", "/.", " ", 
          RowBox[{"fvar", " ", "->", " ", "0"}]}]}], ";", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"gb", ",", " ", 
          RowBox[{"convmat", " ", "/.", " ", "\n", "     ", 
           RowBox[{"Thread", "[", 
            RowBox[{"rvars", " ", "->", " ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"UnitVector", "[", 
                RowBox[{"len", ",", " ", "j"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"j", ",", " ", "len"}], "}"}]}], "]"}]}], "]"}]}]}], 
         "}"}]}]}], "]"}]}], ";"}], "\n"}]}]], "Input",
