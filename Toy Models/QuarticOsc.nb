           RowBox[{
            RowBox[{"coeffs", "[", 
             RowBox[{"[", 
              RowBox[{"k", "+", "1"}], "]"}], "]"}], "/", 
            RowBox[{"k", "!"}]}], " ", 
           RowBox[{"t", "^", "k"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", "nmax"}], "}"}]}], "]"}]}], ";", 
