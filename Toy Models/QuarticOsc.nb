357301a0cbf5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"BW", " ", "order"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"nu", "=", "0"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"BW", " ", "level"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"order", "=", "80"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"E", 
      RowBox[{"(", 
       RowBox[{"n", ";", "\[HBar]"}], ")"}]}], " ", "=", " ", 
     RowBox[{
      SubscriptBox["\[Sum]", 
       RowBox[{"r", " "}]], 
      RowBox[{
       SubscriptBox[
        SuperscriptBox["E", 
         RowBox[{"(", "0", ")"}]], "r"], " ", 
       SuperscriptBox["\[HBar]", "r"]}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bwRaw", "=", 
     RowBox[{"BenderWu", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "^", "2"}], "/", "2"}], "+", 
        RowBox[{"a", " ", 
         RowBox[{"x", "^", "3"}]}], "+", 
        RowBox[{"b", " ", 
         RowBox[{"x", "^", "4"}]}]}], ",", "x", ",", "nu", ",", "order", ",", 
       
       RowBox[{"Simplify", "->", "True"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coeffsSym", "=", 
     RowBox[{"BWProcess", "[", 
      RowBox[{"bwRaw", ",", 
       RowBox[{"Output", "->", "\"\<Energy\>\""}], ",", 
       RowBox[{"OutputStyle", "->", "\"\<Array\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"coeffs", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"coeffsSym", "/.", " ", "pars"}], ",", "10"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.987695428379242*^9, 3.987695428382028*^9}, 
   3.987696017908084*^9, {3.987696370296545*^9, 3.9876963798145037`*^9}, {
