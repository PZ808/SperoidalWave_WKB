    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", " ", "Borel"}]}], " ", "Pade", "  ", "\[ScriptCapitalB]E", 
     
     RowBox[{"(", "t", ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"[", 
       RowBox[{"L", "/", "M"}], "]"}], 
      RowBox[{
       RowBox[{"(", "t", ")"}], "   ", "--"}]}], "-"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BorelPade", "[", 
     RowBox[{"coeffs_List", ",", "t_", ",", "L_Integer", ",", "M_Integer"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nmax", ",", "ser"}], "}"}], ",", 
      RowBox[{
       RowBox[{"nmax", "=", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "coeffs", "]"}], "-", "1"}], ",", 
          RowBox[{"L", "+", "M"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ser", "=", 
