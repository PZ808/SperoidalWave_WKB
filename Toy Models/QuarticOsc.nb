               RowBox[{"(", 
                RowBox[{"k", " ", 
                 RowBox[{"(", 
                  RowBox[{"k", "-", "1"}], ")"}], " ", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"E", ",", 
                   RowBox[{"k", "-", "2"}]}], "]"}]}], ")"}]}], "]"}], "]"}], 
            "]"}], ",", "18"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"Style", "[", 
        RowBox[{
        "\"\<Two-step large-order ratio\>\"", ",", "20", ",", "Bold", ",", 
         RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}]}], ",", 
      RowBox[{"ImageSize", "->", "700"}]}], "]"}]}], ";"}], 
