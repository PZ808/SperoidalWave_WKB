Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Keep", " ", "only", " ", "stable", " ", "Richardson", " ", "levels"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"rich0", "=", "ratioData"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rich1", "=", 
     RowBox[{"Richardson", "[", 
      RowBox[{"ratioData", ",", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rich2", "=", 
     RowBox[{"Richardson", "[", 
      RowBox[{"ratioData", ",", "2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rich4", "=", 
     RowBox[{"Richardson", "[", 
      RowBox[{"ratioData", ",", "4"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rich6", "=", 
     RowBox[{"Richardson", "[", 
      RowBox[{"ratioData", ",", "6"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Trim", " ", "the", " ", "unstable", " ", "tail"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"trim", "[", 
      RowBox[{"data_", ",", "kmax_"}], "]"}], ":=", 
     RowBox[{"Select", "[", 
      RowBox[{"data", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<=", "kmax"}], "&"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kmaxPlot", "=", "60"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stableData", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"trim", "[", 
        RowBox[{"#", ",", "kmaxPlot"}], "]"}], "&"}], "/@", 
      RowBox[{"{", 
       RowBox[{
       "rich0", ",", "rich1", ",", "rich2", ",", "rich4", ",", "rich6"}], 
       "}"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"figStable", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"stableData", ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"Axes", "->", "False"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{"Gray", ",", "Thin"}], "]"}], ",", 
          RowBox[{"Directive", "[", 
           RowBox[{"Blue", ",", "Thick"}], "]"}], ",", 
          RowBox[{"Directive", "[", 
           RowBox[{"Orange", ",", "Thick"}], "]"}], ",", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"Darker", "[", "Green", "]"}], ",", "Thick"}], "]"}], ",", 
          RowBox[{"Directive", "[", 
           RowBox[{"Purple", ",", "Thick"}], "]"}]}], "}"}]}], ",", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", 
       RowBox[{"GridLinesStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"GrayLevel", "[", "0.85", "]"}], ",", "Dashed"}], "]"}]}], 
       ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<perturbative order k\>\"", ",", "18"}], "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"TraditionalForm", "[", 
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"E", ",", "k"}], "]"}], "/", 
              RowBox[{"(", 
               RowBox[{"k", " ", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"E", ",", 
                  RowBox[{"k", "-", "1"}]}], "]"}]}], ")"}]}], "]"}], ",", 
            "18"}], "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "\"\<raw\>\"", ",", "\"\<R1\>\"", ",", "\"\<R2\>\"", ",", 
