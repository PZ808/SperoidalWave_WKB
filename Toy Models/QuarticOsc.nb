  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"V", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "^", "2"}], "/", "2"}], "+", 
      RowBox[{"a", " ", 
       RowBox[{"x", "^", "3"}]}], "+", 
      RowBox[{"b", " ", 
       RowBox[{"x", "^", "4"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Solve", " ", "for", " ", "classical", " ", "turning", " ", 
