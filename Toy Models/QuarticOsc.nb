Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"BorelCoeffs", ",", "BorelSeries"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", " ", "Borel"}]}], " ", "transform", " ", "of", " ", "E", 
     " ", "series", " ", "is", " ", "\[ScriptCapitalB]E", 
     RowBox[{"(", "t", ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Sum]", "k"], " ", 
      RowBox[{
       SubscriptBox["E", "k"], 
       RowBox[{
        FractionBox[
         SuperscriptBox["t", "k"], 
         RowBox[{"k", "!"}]], " ", "--"}]}]}], "-"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BorelCoeffs", "[", "coeffs_List", "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"coeffs", "[", 
        RowBox[{"[", 
         RowBox[{"k", "+", "1"}], "]"}], "]"}], "/", 
       RowBox[{"k", "!"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", 
        RowBox[{
         RowBox[{"Length", "[", "coeffs", "]"}], "-", "1"}]}], "}"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BorelSeries", "[", 
     RowBox[{"coeffs_List", ",", "t_"}], "]"}], ":=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"coeffs", "[", 
         RowBox[{"[", 
          RowBox[{"k", "+", "1"}], "]"}], "]"}], "/", 
        RowBox[{"k", "!"}]}], " ", 
       RowBox[{"t", "^", "k"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", 
        RowBox[{
         RowBox[{"Length", "[", "coeffs", "]"}], "-", "1"}]}], "}"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"borelCoeffs", "=", 
   RowBox[{"BorelCoeffs", "[", "coeffs", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.98769661475916*^9, 3.987696614762052*^9}, {
