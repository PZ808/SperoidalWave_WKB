 RowBox[{
  RowBox[{
   RowBox[{"LargeOrderReconstructionError", "[", 
    RowBox[{
    "coeffs_List", ",", "S_", ",", "beta_", ",", "M_Integer", ",", 
     "kfitmin_Integer", ",", "kfitmax_Integer", ",", "kplotmin_Integer", ",", 
     "kplotmax_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fitObj", ",", "pars", ",", "pred"}], "}"}], ",", 
     RowBox[{
      RowBox[{"fitObj", "=", 
       RowBox[{"FitLargeOrderTower", "[", 
        RowBox[{
        "coeffs", ",", "S", ",", "beta", ",", "M", ",", "kfitmin", ",", 
         "kfitmax"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"pars", "=", 
       RowBox[{"fitObj", "[", "\"\<Parameters\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"pred", "=", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"pars", "[", 
              RowBox[{"[", 
               RowBox[{"n", "+", "1"}], "]"}], "]"}], " ", 
             RowBox[{"LargeOrderBasisTerm", "[", 
              RowBox[{"kk", ",", "S", ",", "beta", ",", "n"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", "0", ",", "M"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"kk", ",", 
           RowBox[{"Log10", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"coeffs", "[", 
                 RowBox[{"[", 
                  RowBox[{"kk", "+", "1"}], "]"}], "]"}], "-", "pred"}], 
               ")"}], "/", 
              RowBox[{"coeffs", "[", 
               RowBox[{"[", 
                RowBox[{"kk", "+", "1"}], "]"}], "]"}]}], "]"}], "]"}]}], 
          "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"kk", ",", "kplotmin", ",", "kplotmax"}], "}"}]}], "]"}]}]}],
     "]"}]}], ";"}]}], "Input",
