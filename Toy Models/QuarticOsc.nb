Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "PadePoles", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PadePoles", "[", 
     RowBox[{"rat_", ",", "t_", ",", 
      RowBox[{"wp_", ":", "80"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"den", ",", "roots"}], "}"}], ",", 
      RowBox[{
       RowBox[{"den", "=", 
        RowBox[{"Denominator", "[", 
         RowBox[{"Together", "[", "rat", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"roots", "=", 
        RowBox[{"t", "/.", " ", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{"den", "==", "0"}], ",", "t", ",", 
           RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"N", "[", 
        RowBox[{"roots", ",", "wp"}], "]"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "RightHalfPlanePoles", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RightHalfPlanePoles", "[", "poles_List", "]"}], ":=", 
    RowBox[{"SortBy", "[", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"poles", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"N", "[", "#", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}], 
      ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Arg", "[", 
           RowBox[{"N", "[", "#", "]"}], "]"}], "]"}], ",", 
         RowBox[{"Re", "[", 
          RowBox[{"N", "[", "#", "]"}], "]"}]}], "}"}], "&"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "LeadingPadePoleRobust", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LeadingPadePoleRobust", "[", "poles_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "right", "}"}], ",", 
     RowBox[{
      RowBox[{"right", "=", 
       RowBox[{"RightHalfPlanePoles", "[", "poles", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "right", "]"}], "==", "0"}], ",", 
        RowBox[{"Missing", "[", "\"\<NoRightHalfPlanePole\>\"", "]"}], ",", 
        RowBox[{"First", "[", "right", "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.987698486214732*^9, 3.987698486217555*^9}},
 CellLabel->
  "In[468]:=",ExpressionUUID->"12d3693d-0a50-4125-ac5e-4dfe9a0ecc4f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "LeadingBorelPole", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "LeadingBorelPole", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"ImaginaryTolerance", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "2"}]}]}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LeadingBorelPole", "[", 
    RowBox[{"poles_List", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tol", ",", "candidates"}], "}"}], ",", 
     RowBox[{
      RowBox[{"tol", "=", 
       RowBox[{"OptionValue", "[", "ImaginaryTolerance", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"candidates", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"poles", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Re", "[", "#", "]"}], ">", "0"}], "&&", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"Im", "[", "#", "]"}], "]"}], "<", 
            RowBox[{"tol", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"1", ",", 
               RowBox[{"Abs", "[", 
                RowBox[{"Re", "[", "#", "]"}], "]"}]}], "]"}]}]}]}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "candidates", "]"}], "==", "0"}], ",", 
        RowBox[{"Missing", "[", "\"\<None\>\"", "]"}], ",", 
        RowBox[{"First", "[", 
         RowBox[{"SortBy", "[", 
          RowBox[{"candidates", ",", "Re"}], "]"}], "]"}]}], "]"}]}]}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.987697885068479*^9, 3.987697885071169*^9}},
 CellLabel->
  "In[465]:=",ExpressionUUID->"e992541d-e34a-49fd-8c72-b2d0576dfc7c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "Richardson", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Richardson", "[", 
    RowBox[{"data_List", ",", "pmax_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", ",", "ks", ",", "newVals", ",", "newKs", ",", "p"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"vals", "=", 
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ks", "=", 
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"p", "=", "1"}], ",", 
        RowBox[{
         RowBox[{"p", "<=", "pmax"}], "&&", 
         RowBox[{
          RowBox[{"Length", "[", "vals", "]"}], ">=", "2"}]}], ",", 
        RowBox[{"p", "++"}], ",", 
        RowBox[{
         RowBox[{"newVals", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"ks", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", "+", "1"}], "]"}], "]"}], "^", "p"}], " ", 
                RowBox[{"vals", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", "+", "1"}], "]"}], "]"}]}], "-", 
               RowBox[{
                RowBox[{
                 RowBox[{"ks", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "^", "p"}], " ", 
                RowBox[{"vals", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"ks", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", "+", "1"}], "]"}], "]"}], "^", "p"}], "-", 
               RowBox[{
                RowBox[{"ks", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "^", "p"}]}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", 
              RowBox[{
               RowBox[{"Length", "[", "vals", "]"}], "-", "1"}]}], "}"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"newKs", "=", 
          RowBox[{"Most", "[", "ks", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"vals", "=", "newVals"}], ";", "\[IndentingNewLine]", 
         RowBox[{"ks", "=", "newKs"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"ks", ",", "vals"}], "}"}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.987696853055153*^9, 3.9876968530573807`*^9}},
 CellLabel->
  "In[329]:=",ExpressionUUID->"94991c14-e409-42ba-b420-b018c66bf051"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "BorelPadeSum", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "BorelPadeSum", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"WorkingPrecision", "->", "80"}], ",", 
      RowBox[{"AccuracyGoal", "->", "40"}], ",", 
      RowBox[{"PrecisionGoal", "->", "40"}], ",", 
      RowBox[{"MaxRecursion", "->", "40"}], ",", 
      RowBox[{"DirectionAngle", "->", "0"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"BorelPadeSum", "[", 
    RowBox[{"coeffs_List", ",", 
     RowBox[{"z0_", "?", "NumericQ"}], ",", "L_Integer", ",", "M_Integer", 
     ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "t", ",", "s", ",", "theta", ",", "bpExpr", ",", "wp", ",", "ag", ",", 
       "pg", ",", "mr", ",", "z"}], "}"}], ",", 
     RowBox[{
      RowBox[{"theta", "=", 
       RowBox[{"OptionValue", "[", "DirectionAngle", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", 
       RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ag", "=", 
       RowBox[{"OptionValue", "[", "AccuracyGoal", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pg", "=", 
       RowBox[{"OptionValue", "[", "PrecisionGoal", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mr", "=", 
       RowBox[{"OptionValue", "[", "MaxRecursion", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"z", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{"z0", ",", "wp"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"bpExpr", "=", 
       RowBox[{"BorelPade", "[", 
        RowBox[{"coeffs", ",", "t", ",", "L", ",", "M"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"Evaluate", "[", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"-", "s"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"bpExpr", "/.", " ", 
            RowBox[{"t", "->", 
             RowBox[{"z", " ", "s", " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"I", " ", "theta"}], "]"}]}]}]}], ")"}], "*", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "theta"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "0", ",", "Infinity"}], "}"}], ",", 
        RowBox[{"WorkingPrecision", "->", "wp"}], ",", 
        RowBox[{"AccuracyGoal", "->", "ag"}], ",", 
        RowBox[{"PrecisionGoal", "->", "pg"}], ",", 
        RowBox[{"MaxRecursion", "->", "mr"}], ",", 
        RowBox[{"Method", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
           RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}]}], 
       "]"}]}]}], "]"}]}], ";"}]}], "Input",
