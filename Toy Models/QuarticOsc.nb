Notebook[{

Cell[CellGroupData[{
Cell["Asymmetric Quartic Large-order WKB ", "Title",
 CellChangeTimes->{{3.987695714169647*^9, 
  3.9876957371868258`*^9}},ExpressionUUID->"6027905f-c03a-483e-b3a1-\
765d8bd09eb4"],

Cell[TextData[{
 "We compute the large order transseries asymptotics using Bender Wu for the \
1-d Schroedinger problem  \
-\[HBar]/2\[Psi]\[CloseCurlyQuote]\[CloseCurlyQuote](x) +\[Psi](x)V(x) = E \
\[Psi](x) with V(x) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "4"], "-", 
    SuperscriptBox["\[Alpha]x", "3"], "+", 
    SuperscriptBox["\[Beta]x", "2"], "+", "\[Gamma]x"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6b13b5c7-e9c3-416d-9329-c9664eb24db5"],
 ".\nThe classical momentum  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"p", "(", 
      RowBox[{"x", ";", "E"}], ")"}], "2"], "=", 
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{"E", "-", "V"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "23a6b169-fe43-498c-a76c-11da345fb0d3"],
 " defines an associated WKB curve given by a genus-one hyperelliptic curve \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalSigma]", " ", ":", " ", 
     SuperscriptBox["y", "2"]}], "=", 
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{"E", "-", 
       RowBox[{"V", "(", "x", ")"}]}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b0bdbec6-cb4e-436a-bc15-b361e1368640"],
 " \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["y", "2"], "=", " ", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2647ec34-a7e3-44fe-8827-3600c722b113"],
 "E -2 (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "4"], "-", 
    SuperscriptBox["\[Alpha]x", "3"], "+", 
    SuperscriptBox["\[Beta]x", "2"], "+", "\[Gamma]x"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f514b082-c47b-4a95-bb34-d66d17c32724"],
 ") .\n\nThis is the toy analogue of the spin-weighted spheroidal quartic. \
Meynig\[CloseCurlyQuote]s spheroidal analysis uses exact WKB quantum periods \
and a perturbative/nonperturbative relation to build the transseries for the \
eigenvalue; the paper explicitly frames the spheroidal problem in terms of \
all-orders WKB, quantum periods, and a first exponential correction checked \
by numerical resurgence."
}], "Abstract",
 CellChangeTimes->{{3.987695744655818*^9, 
  3.987695973175432*^9}},ExpressionUUID->"07a2f612-763f-4076-898a-\
2c29bae9a060"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<BenderWu`\>\"", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.987695364079344*^9, 3.987695364081059*^9}},
 CellLabel->
  "In[247]:=",ExpressionUUID->"2c4db5df-4ad5-479e-9997-43221f057122"],

