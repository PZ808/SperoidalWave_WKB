Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "TwoStepRatioData", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TwoStepRatioData", "[", "cs_List", "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"cs", "[", 
          RowBox[{"[", 
           RowBox[{"k", "-", "1"}], "]"}], "]"}], "=!=", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"cs", "[", 
              RowBox[{"[", 
               RowBox[{"k", "+", "1"}], "]"}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{"k", " ", 
               RowBox[{"(", 
                RowBox[{"k", "-", "1"}], ")"}], " ", 
               RowBox[{"cs", "[", 
                RowBox[{"[", 
                 RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}]}], "]"}], 
           "]"}]}], "}"}], ",", "Nothing"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "2", ",", 
        RowBox[{
         RowBox[{"Length", "[", "cs", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"twoStepData", "=", 
    RowBox[{"TwoStepRatioData", "[", "coeffs", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"twoStepPlot", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{"twoStepData", ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"Axes", "->", "False"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Blue", ",", "Thick"}], "]"}]}], ",", 
      RowBox[{"GridLines", "->", "Automatic"}], ",", 
      RowBox[{"GridLinesStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{
         RowBox[{"GrayLevel", "[", "0.85", "]"}], ",", "Dashed"}], "]"}]}], 
      ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
