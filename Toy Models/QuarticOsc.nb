Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"Re", "[", "SfromPade", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"beta", "=", "0"}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"first", " ", "try"}], ";", 
    RowBox[{
     RowBox[{
     "adjust", " ", "later", " ", "if", " ", "you", " ", "know", " ", "the", 
      " ", "one"}], "-", 
     RowBox[{"loop", " ", "exponent"}]}]}], "*)"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Cest", "=", 
    RowBox[{"EstimateStokesPrefactor", "[", 
     RowBox[{
     "coeffs", ",", "S", ",", "beta", ",", "1", ",", "40", ",", "70"}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"N", "[", 
  RowBox[{"Cest", ",", "30"}], "]"}]}], "Input",
