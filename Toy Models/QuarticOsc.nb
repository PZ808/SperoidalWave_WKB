Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "AnalyzeAsymmetricQuartic", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "AnalyzeAsymmetricQuartic", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Order", "->", "80"}], ",", 
      RowBox[{"Level", "->", "0"}], ",", 
      RowBox[{"Parameters", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "->", 
          RowBox[{"1", "/", "5"}]}], ",", 
         RowBox[{"b", "->", "1"}]}], "}"}]}], ",", 
      RowBox[{"PadeOrder", "->", 
       RowBox[{"{", 
        RowBox[{"35", ",", "35"}], "}"}]}], ",", 
      RowBox[{"ZValue", "->", "0.05"}], ",", 
      RowBox[{"WorkingPrecision", "->", "80"}]}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AnalyzeAsymmetricQuartic", "[", 
    RowBox[{"OptionsPattern", "[", "]"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ord", ",", "lev", ",", "pars", ",", "pade", ",", "z0", ",", "wp", ",", 
       "raw", ",", "cs", ",", "t", ",", "bp", ",", "poles", ",", "realPoles", 
       ",", "ratioData", ",", "leadingPole", ",", "richOrder", ",", " ", 
       "rich4", ",", "invS", ",", "Sratio", ",", "sum"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ord", "=", 
       RowBox[{"OptionValue", "[", "Order", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lev", "=", 
       RowBox[{"OptionValue", "[", "Level", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pars", "=", 
       RowBox[{"OptionValue", "[", "Parameters", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pade", "=", 
       RowBox[{"OptionValue", "[", "PadeOrder", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"z0", "=", 
       RowBox[{"OptionValue", "[", "ZValue", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wp", "=", 
       RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", "pade", "]"}], ">", "ord"}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", 
          "\"\<Warning: PadeOrder too high for available coefficients. \
Reducing it.\>\"", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"pade", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Floor", "[", 
             RowBox[{"ord", "/", "2"}], "]"}], ",", 
            RowBox[{"Floor", "[", 
             RowBox[{"ord", "/", "2"}], "]"}]}], "}"}]}], ";"}]}], "]"}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"raw", "=", 
       RowBox[{"BenderWu", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"x", "^", "2"}], "/", "2"}], "+", 
          RowBox[{"a", " ", 
           RowBox[{"x", "^", "3"}]}], "+", 
          RowBox[{"b", " ", 
           RowBox[{"x", "^", "4"}]}]}], ",", "x", ",", "lev", ",", "ord", ",", 
         RowBox[{"Simplify", "->", "True"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"cs", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"BWProcess", "[", 
           RowBox[{"raw", ",", 
            RowBox[{"Output", "->", "\"\<Energy\>\""}], ",", 
            RowBox[{"OutputStyle", "->", "\"\<Array\>\""}]}], "]"}], "/.", 
          " ", "pars"}], ",", "wp"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"bp", "=", 
       RowBox[{"BorelPade", "[", 
        RowBox[{"cs", ",", "t", ",", 
         RowBox[{"pade", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"pade", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"poles", "=", 
       RowBox[{"PadePoles", "[", 
        RowBox[{"bp", ",", "t", ",", "wp"}], "]"}]}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{"rightHalfPoles", "=", 
       RowBox[{"RightHalfPlanePoles", "[", "poles", "]"}]}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{"leadingPole", "=", 
       RowBox[{"LeadingPadePoleRobust", "[", "poles", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"ratioData", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{
            RowBox[{"cs", "[", 
             RowBox[{"[", 
              RowBox[{"k", "+", "1"}], "]"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"k", " ", 
              RowBox[{"cs", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], ")"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{
            RowBox[{"Length", "[", "cs", "]"}], "-", "1"}]}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"richOrder", "=", 
       RowBox[{"Min", "[", 
        RowBox[{"4", ",", 
         RowBox[{
          RowBox[{"Length", "[", "ratioData", "]"}], "-", "2"}]}], "]"}]}], 
      ";", "\n", "\[IndentingNewLine]", 
      RowBox[{"rich4", "=", 
       RowBox[{"Richardson", "[", 
        RowBox[{"ratioData", ",", "richOrder"}], "]"}]}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{"invS", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ListQ", "[", "rich4", "]"}], "&&", 
          RowBox[{
           RowBox[{"Length", "[", "rich4", "]"}], ">", "0"}], "&&", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Last", "[", "rich4", "]"}], "]"}], ">=", "2"}]}], ",", 
         RowBox[{
          RowBox[{"Last", "[", "rich4", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"Missing", "[", "\"\<NotEnoughData\>\"", "]"}]}], "]"}]}], 
      ";", "\n", "\[IndentingNewLine]", 
      RowBox[{"Sratio", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"NumberQ", "[", "invS", "]"}], ",", 
         RowBox[{"1", "/", "invS"}], ",", 
         RowBox[{"Missing", "[", "\"\<NotEnoughData\>\"", "]"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"sum", "=", 
       RowBox[{"BorelPadeSum", "[", 
        RowBox[{"cs", ",", "z0", ",", 
         RowBox[{"pade", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"pade", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Coefficients\>\"", "->", "cs"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<BorelPade\>\"", "->", "bp"}], ",", "\[IndentingNewLine]", 
        RowBox[{"\"\<PadePoles\>\"", "->", "poles"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<RightHalfPlanePoles\>\"", "->", "rightHalfPoles"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<LeadingPadePole\>\"", "->", "leadingPole"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<RatioData\>\"", "->", "ratioData"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<Richardson4\>\"", "->", "rich4"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<SFromRatios\>\"", "->", "Sratio"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"\"\<BorelPadeSum\>\"", "->", "sum"}]}], "|>"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.987696434258335*^9, 3.987696434260415*^9}, {
   3.9876964962615337`*^9, 3.987696527429841*^9}, {3.987696870312887*^9, 
