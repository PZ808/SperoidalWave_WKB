Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "ResurgencePoint", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ResurgencePoint", "[", 
    RowBox[{
     RowBox[{"aVal_", "?", "NumericQ"}], ",", 
     RowBox[{"bVal_", "?", "NumericQ"}], ",", "lev_Integer", ",", 
     "ord_Integer", ",", "richOrder_Integer", ",", "padeOrder_List", ",", 
     RowBox[{"wp_", ":", "80"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "cs", ",", "ratios", ",", "rich", ",", "invSRich", ",", "SRich", ",", 
       "pade", ",", "SPad", ",", "invSPad"}], "}"}], ",", 
     RowBox[{
      RowBox[{"cs", "=", 
       RowBox[{"QuarticCoefficients", "[", 
        RowBox[{"aVal", ",", "bVal", ",", "lev", ",", "ord", ",", "wp"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ratios", "=", 
       RowBox[{"LargeOrderRatioData", "[", "cs", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rich", "=", 
       RowBox[{"Richardson", "[", 
        RowBox[{"ratios", ",", "richOrder"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"invSRich", "=", 
       RowBox[{
        RowBox[{"Last", "[", "rich", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"SRich", "=", 
       RowBox[{"1", "/", "invSRich"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"pade", "=", 
       RowBox[{"ActionFromPade", "[", 
        RowBox[{"cs", ",", "padeOrder", ",", "wp"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SPad", "=", 
       RowBox[{"pade", "[", "\"\<S\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"invSPad", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "SPad", "]"}], "===", "Missing"}], ",", 
         RowBox[{"Missing", "[", "\"\<NoPole\>\"", "]"}], ",", 
         RowBox[{"1", "/", 
          RowBox[{"Re", "[", "SPad", "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<a\>\"", "->", "aVal"}], ",", 
        RowBox[{"\"\<Coefficients\>\"", "->", "cs"}], ",", 
        RowBox[{"\"\<InvSFromRichardson\>\"", "->", "invSRich"}], ",", 
        RowBox[{"\"\<SFromRichardson\>\"", "->", "SRich"}], ",", 
        RowBox[{"\"\<SFromPade\>\"", "->", "SPad"}], ",", 
        RowBox[{"\"\<InvSFromPade\>\"", "->", "invSPad"}]}], "|>"}]}]}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9877467229799967`*^9, 3.9877467229823647`*^9}},
 CellLabel->
  "In[608]:=",ExpressionUUID->"1f736a27-ca44-455d-863b-6bcf530cd9a4"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Large", "-", 
    RowBox[{"order", " ", "ratio"}]}], "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "LargeOrderRatioData", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"LargeOrderRatioData", "[", "coeffs_List", "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{
          RowBox[{"coeffs", "[", 
           RowBox[{"[", 
            RowBox[{"k", "+", "1"}], "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"k", " ", 
            RowBox[{"coeffs", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", 
         RowBox[{
          RowBox[{"Length", "[", "coeffs", "]"}], "-", "1"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Richardson", " ", "acceleration"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "Richardson", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Richardson", "[", 
      RowBox[{"data_List", ",", "pmax_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vals", ",", "ks", ",", "newVals", ",", "newKs", ",", "p"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"vals", "=", 
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ks", "=", 
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"p", "=", "1"}], ",", 
          RowBox[{
           RowBox[{"p", "<=", "pmax"}], "&&", 
           RowBox[{
            RowBox[{"Length", "[", "vals", "]"}], ">=", "2"}]}], ",", 
          RowBox[{"p", "++"}], ",", 
          RowBox[{
           RowBox[{"newVals", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"ks", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}], "^", "p"}], " ", 
                  RowBox[{"vals", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}]}], "-", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"ks", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "^", "p"}], " ", 
                  RowBox[{"vals", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"ks", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}], "^", "p"}], "-", 
                 RowBox[{
                  RowBox[{"ks", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "^", "p"}]}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", 
                RowBox[{
                 RowBox[{"Length", "[", "vals", "]"}], "-", "1"}]}], "}"}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"newKs", "=", 
            RowBox[{"Most", "[", "ks", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"vals", "=", "newVals"}], ";", "\[IndentingNewLine]", 
           RowBox[{"ks", "=", "newKs"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"ks", ",", "vals"}], "}"}], "]"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.987746746747265*^9, 3.987746760575979*^9}},
 CellLabel->
  "In[610]:=",ExpressionUUID->"4573af09-0270-47ee-98df-0d6e20cd555c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"BorelTransformSeries", ",", "BorelPade", ",", "PadePoles"}], 
    "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BorelTransformSeries", "[", 
     RowBox[{"coeffs_List", ",", "t_", ",", 
      RowBox[{"nmax_", ":", "Automatic"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "n", "}"}], ",", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nmax", "===", "Automatic"}], ",", 
          RowBox[{
           RowBox[{"Length", "[", "coeffs", "]"}], "-", "1"}], ",", "nmax"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"coeffs", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1"}], "]"}], "]"}], "/", 
           RowBox[{"k", "!"}]}], " ", 
          RowBox[{"t", "^", "k"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", 
           RowBox[{"Min", "[", 
            RowBox[{"n", ",", 
             RowBox[{
              RowBox[{"Length", "[", "coeffs", "]"}], "-", "1"}]}], "]"}]}], 
          "}"}]}], "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BorelPade", "[", 
     RowBox[{"coeffs_List", ",", "t_", ",", "L_Integer", ",", "M_Integer"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nmax", ",", "ser"}], "}"}], ",", 
      RowBox[{
       RowBox[{"nmax", "=", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "coeffs", "]"}], "-", "1"}], ",", 
          RowBox[{"L", "+", "M"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ser", "=", 
        RowBox[{"BorelTransformSeries", "[", 
         RowBox[{"coeffs", ",", "t", ",", "nmax"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"PadeApproximant", "[", 
        RowBox[{"ser", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", 
           RowBox[{"{", 
            RowBox[{"L", ",", "M"}], "}"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PadePoles", "[", 
     RowBox[{"rat_", ",", "t_", ",", 
      RowBox[{"wp_", ":", "80"}]}], "]"}], ":=", 
