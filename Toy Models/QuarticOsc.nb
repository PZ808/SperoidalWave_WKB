      "k_Integer", ",", "S_", ",", "beta_", ",", "C_", ",", "instCoeffs_List",
        ",", "M_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "mmax", "}"}], ",", 
       RowBox[{
        RowBox[{"mmax", "=", 
