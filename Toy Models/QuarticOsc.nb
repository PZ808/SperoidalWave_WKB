    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nmax", ",", "ser"}], "}"}], ",", 
     RowBox[{
      RowBox[{"nmax", "=", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "coeffs", "]"}], "-", "1"}], ",", 
         RowBox[{"L", "+", "M"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ser", "=", 
       RowBox[{"BorelTransformSeries", "[", 
        RowBox[{"coeffs", ",", "t", ",", "nmax"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"PadeApproximant", "[", 
       RowBox[{"ser", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", 
