Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "ResurgenceClosureData", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ResurgenceClosureData", "[", 
    RowBox[{
    "pertCoeffs_List", ",", "S_", ",", "beta_", ",", "C_", ",", 
     "instCoeffs_List", ",", "M_Integer", ",", "kmin_Integer", ",", 
     "kmax_Integer"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"actual", "=", 
          RowBox[{"pertCoeffs", "[", 
           RowBox[{"[", 
            RowBox[{"k", "+", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"pred", "=", 
          RowBox[{"LargeOrderPrediction", "[", 
           RowBox[{
           "k", ",", "S", ",", "beta", ",", "C", ",", "instCoeffs", ",", 
            "M"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"Log10", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"actual", "-", "pred"}], ")"}], "/", "actual"}], "]"}], 
          "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "kmin", ",", "kmax"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.987747996293359*^9, 3.987747996295619*^9}},
 CellLabel->
  "In[705]:=",ExpressionUUID->"b2515484-a275-40c2-8a66-d82382045893"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kmin", "=", "20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kmax", "=", 
    RowBox[{"Min", "[", 
     RowBox[{
      RowBox[{
