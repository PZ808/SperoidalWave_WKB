Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "LargeOrderBasisTerm", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LargeOrderBasisTerm", "[", 
    RowBox[{"k_", ",", "S_", ",", "beta_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Gamma", "[", 
     RowBox[{"k", "+", "beta", "-", "n"}], "]"}], "/", 
    RowBox[{"S", "^", 
     RowBox[{"(", 
      RowBox[{"k", "+", "beta", "-", "n"}], ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.987748103293046*^9, 3.9877481032952538`*^9}},
 CellLabel->
  "In[724]:=",ExpressionUUID->"a63478f5-5e87-4d34-8793-f9a7de397ed5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "FitLargeOrderTower", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FitLargeOrderTower", "[", 
    RowBox[{
    "coeffs_List", ",", "S_", ",", "beta_", ",", "M_Integer", ",", 
     "kfitmin_Integer", ",", "kfitmax_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", ",", "pars", ",", "model", ",", "fit", ",", "k"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"kk", ",", 
           RowBox[{"coeffs", "[", 
            RowBox[{"[", 
             RowBox[{"kk", "+", "1"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"kk", ",", "kfitmin", ",", "kfitmax"}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"pars", "=", 
       RowBox[{"Array", "[", 
        RowBox[{"A", ",", 
         RowBox[{"M", "+", "1"}], ",", "0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"model", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"pars", "[", 
           RowBox[{"[", 
            RowBox[{"n", "+", "1"}], "]"}], "]"}], " ", 
          RowBox[{"LargeOrderBasisTerm", "[", 
           RowBox[{"k", ",", "S", ",", "beta", ",", "n"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "M"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fit", "=", 
       RowBox[{"LinearModelFit", "[", 
        RowBox[{"data", ",", "model", ",", "pars", ",", "k"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Fit\>\"", "->", "fit"}], ",", 
        RowBox[{"\"\<Parameters\>\"", "->", 
         RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Model\>\"", "->", "model"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]}], "Input",
