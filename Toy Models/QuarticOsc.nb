Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "ExtractInstantonFluctuations", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ExtractInstantonFluctuations", "[", 
    RowBox[{
    "pertCoeffs_List", ",", "S_", ",", "beta_", ",", "C_", ",", 
     "nmax_Integer", ",", "kmin_Integer", ",", "kmax_Integer"}], "]"}], ":=", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "data", ",", "basis", ",", "fit", ",", "pars"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{
            RowBox[{"pertCoeffs", "[", 
             RowBox[{"[", 
              RowBox[{"k", "+", "1"}], "]"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"C", " ", 
              RowBox[{
               RowBox[{"Gamma", "[", 
                RowBox[{"k", "+", "beta"}], "]"}], "/", 
               RowBox[{"S", "^", 
                RowBox[{"(", 
                 RowBox[{"k", "+", "beta"}], ")"}]}]}]}], ")"}]}]}], "}"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "kmin", ",", "kmax"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"basis", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"S", "^", "n"}], " ", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{"x", "+", "beta", "-", "n"}], "]"}], "/", 
           RowBox[{"Gamma", "[", 
            RowBox[{"x", "+", "beta"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "nmax"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fit", "=", 
       RowBox[{"LinearModelFit", "[", 
        RowBox[{"data", ",", "basis", ",", "x"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pars", "=", 
       RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "pars"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.987748039396427*^9, 3.987748039398258*^9}},
 CellLabel->
  "In[714]:=",ExpressionUUID->"b579545d-49cc-4bda-ab95-053e25981029"],

