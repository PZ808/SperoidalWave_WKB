Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "LeadingBorelPoleByRealAxis", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "LeadingBorelPoleByRealAxis", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"MinRadius", "->", "0.15"}], ",", 
      RowBox[{"MaxAngle", "->", 
       RowBox[{"Pi", "/", "6"}]}]}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LeadingBorelPoleByRealAxis", "[", 
    RowBox[{"poles_List", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rmin", ",", "maxang", ",", "candidates"}], "}"}], ",", 
     RowBox[{
      RowBox[{"rmin", "=", 
       RowBox[{"OptionValue", "[", "MinRadius", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maxang", "=", 
       RowBox[{"OptionValue", "[", "MaxAngle", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"candidates", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"poles", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"N", "[", "#", "]"}], "]"}], ">", "0"}], "&&", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"N", "[", "#", "]"}], "]"}], ">", "rmin"}], "&&", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"Arg", "[", 
              RowBox[{"N", "[", "#", "]"}], "]"}], "]"}], "<", "maxang"}]}], 
          "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "candidates", "]"}], "==", "0"}], ",", 
        RowBox[{"Missing", "[", "\"\<NoPositiveAxisCandidate\>\"", "]"}], ",", 
        RowBox[{"First", "@", 
         RowBox[{"SortBy", "[", 
          RowBox[{"candidates", ",", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"N", "[", "#", "]"}], "]"}], "&"}]}], "]"}]}]}], 
       "]"}]}]}], "]"}]}], ";"}]}], "Input",
