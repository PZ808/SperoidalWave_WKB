 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PadePoles", "[", 
     RowBox[{"rat_", ",", "t_", ",", 
      RowBox[{"wp_", ":", "80"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"den", ",", "roots"}], "}"}], ",", 
      RowBox[{
       RowBox[{"den", "=", 
        RowBox[{"Denominator", "[", 
         RowBox[{"Together", "[", "rat", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"roots", "=", 
        RowBox[{"t", "/.", " ", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{"den", "==", "0"}], ",", "t", ",", 
           RowBox[{"WorkingPrecision", "->", "wp"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"N", "[", 
        RowBox[{"roots", ",", "wp"}], "]"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RightHalfPlanePoles", "[", "poles_List", "]"}], ":=", 
    RowBox[{"SortBy", "[", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"poles", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"N", "[", "#", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}], 
      ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Arg", "[", 
           RowBox[{"N", "[", "#", "]"}], "]"}], "]"}], ",", 
         RowBox[{"Re", "[", 
          RowBox[{"N", "[", "#", "]"}], "]"}]}], "}"}], "&"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
