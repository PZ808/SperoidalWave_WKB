Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "x", ",", "t", ",", "A2", ",", "A4", ",", "A6", ",", "f", ",", 
     "\[CapitalDelta]", ",", "j"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A2", "=", 
   RowBox[{
    RowBox[{"1", "/", "4"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"4", " ", 
       RowBox[{"t", "^", "3"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"A4", "=", 
   RowBox[{
    RowBox[{"1", "/", "3"}], " ", 
    RowBox[{"t", "^", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"t", "^", "3"}], "-", "1"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"A6", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "/", "27"}], " ", "t", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"t", "^", "3"}], "-", "1"}], ")"}], "^", "2"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"x", "^", "3"}], "+", 
    RowBox[{"A2", " ", 
     RowBox[{"x", "^", "2"}]}], "+", 
    RowBox[{"A4", " ", "x"}], "+", "A6"}]}], ";"}]}], "Input",
