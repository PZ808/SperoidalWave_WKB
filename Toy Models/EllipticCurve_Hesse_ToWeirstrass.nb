     "Simplify"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "substitute", " ", "into", " ", "the", " ", "original", " ", "cubic", " ", 
    "and", " ", "clear", " ", "denominators"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Fnew", "=", 
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{"F", "/.", " ", "xyzInNew"}], "]"}], "//", "Simplify"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
