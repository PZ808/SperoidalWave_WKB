Notebook[{

Cell[CellGroupData[{
Cell["Elliptic Curve Picard-Fuchs Analysis", "Title",
 CellChangeTimes->{{3.981357697159197*^9, 
  3.981357718822772*^9}},ExpressionUUID->"7201b701-18d0-4eb6-a0bb-\
0935014eeced"],

Cell[TextData[{
 "Based on Christian Schnell\[CloseCurlyQuote]s article which analyzes the \
equation stating in Hesse Form\nF(x,y,z) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"t", "(", 
     RowBox[{
      SuperscriptBox["x", "3"], "+", 
      SuperscriptBox["y", "3"], "+", 
      SuperscriptBox["z", "3"]}], ")"}], "-", 
    RowBox[{"3", " ", "x", " ", "y", " ", "z"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8feff9ab-dfb4-47b3-a3e6-9adce2964e57"],
 "\nFor fixed  t\[NotEqual]0 this is, up to scaling, the Hesse normal form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"t", "(", 
      RowBox[{
       SuperscriptBox["x", "3"], "+", 
       SuperscriptBox["y", "3"], "+", 
       SuperscriptBox["z", "3"]}], ")"}], "-", 
     RowBox[{"3", " ", "\[Lambda]", " ", "x", " ", "y", " ", "z"}]}], ",", 
    " ", 
    RowBox[{"\[Lambda]", "=", 
     RowBox[{"1", "/", "t"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3dedd959-0742-4683-aee5-b25197fdd9f2"],
 "\nwhich is a standard model of an elliptic curve in the plane. Every \
nonsingular\nplane cubic is projectively equivalent to such a Hesse curve.\n"
}], "Text",
 CellChangeTimes->{{3.98135772334658*^9, 
  3.9813578675829983`*^9}},ExpressionUUID->"18f74c29-0e2b-4e76-b2ee-\
3df18e791f5c"],

Cell[CellGroupData[{

Cell["Reduction to Normal Form", "Section",
 CellChangeTimes->{{3.981357748929447*^9, 
  3.981357754327183*^9}},ExpressionUUID->"6f94de28-db5d-4042-8477-\
26803fbeba66"],

Cell[TextData[{
 "First we choose and affine  chart where z=1\n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"t", "(", 
     RowBox[{
      SuperscriptBox["x", "3"], "+", 
      SuperscriptBox["y", "3"], "+", "1"}], ")"}], "-", 
    RowBox[{"3", " ", "x", " ", "y", " "}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "98a7f923-176f-436a-80ab-628e4b09b28d"],
 "which is \[OpenCurlyDoubleQuote]twisted Hesse\[CloseCurlyDoubleQuote] \
elliptic curve \n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["ax", "3"], "+", 
     SuperscriptBox["y", "3"], "+", "1"}], "=", "dxy", " "}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c62a8d9d-fd61-4088-aa3f-dd319251cf4a"],
 "with d=3 and a = t.\n( \
https://people.tamu.edu/~rojas//cubic2weierstrass.pdf?utm_source=chatgpt.com)\
\n\nThere is a standard projective algorithm (explained e.g. in\nSilverman\
\[Dash]Tate or in the notes by Duif on transforming a general cubic to\n\
Weierstrass form) which, roughly, does the following:\n\nPick a flex point on \
the cubic and move it to infinity by a linear\nchange of projective \
coordinates.\nFor a Hesse curve this is easy because the flexes are known \
explicitly;\nfor the twisted Hessian form (*) one convenient choice is the \
point\n(0,\[Minus]1) in the affine chart.\n\nMake the tangent at that flex \
the line at infinity Z=0\nAfter this step, the resulting projective model has \
exactly one point at\ninfinity, which will be the group identity on the \
elliptic curve.\n\nEliminate mixed terms so that in the new affine chart Z=1 \
the\nequation becomes quadratic in one variable, say\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["Y", "2"], "+", "a1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9b1803f7-aee4-4ae2-8f33-705eac48db63"],
 "XY+a3 ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Y", "=", 
    SuperscriptBox["X", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "22b22c8d-f56a-496f-ba66-6ff66288b179"],
 "+a2 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["X", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4a8fba5f-b6f8-4535-99bf-0f835799f0bd"],
 "+a4 X+a6.\nComplete the square in  Y\nY to arrive at\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\n", 
    RowBox[{
     SuperscriptBox["Y", 
      RowBox[{"'", "2"}]], "=", 
     RowBox[{
      SuperscriptBox["X", "3"], "+", 
      SuperscriptBox["AX", "2"], "+", "BX", "+", "C"}]}]}], TraditionalForm]],
  
  FormatType->TraditionalForm,ExpressionUUID->
  "c1fded27-eb26-446e-939e-3f5ac490443c"],
 "\n\n(in characteristic \[NotEqual]2,3 one can even kill the \n",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["X", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "47a6a125-6ff1-47a3-9eb2-769a246b979f"],
 " term and get the short Weierstrass form \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "^", "2"}], "=", 
    SuperscriptBox["x", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9ae79b87-3cee-442e-a27e-57f7a2623822"],
 "+Ax+B\nCarrying this out with \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", " ", "=", " ", 
    RowBox[{"t", "(", 
     RowBox[{
      SuperscriptBox["x", "3"], "+", 
      SuperscriptBox["y", "3"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5520536f-98fd-4034-b78e-42a825449d6f"],
 "+1)\[Minus]3xy\n is straightforward but very\ncomputationally heavy by \
hand; that\[CloseCurlyQuote]s why Schnell suggests using\nMathematica and so \
here we are..."
}], "Text",
 CellChangeTimes->{{3.981357882798822*^9, 3.9813581360838537`*^9}, {
  3.981358191924171*^9, 
  3.981358312375518*^9}},ExpressionUUID->"dedba096-0460-4a01-af7f-\
43ee44fab6d5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "y", ",", "z", ",", "t", ",", "L"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"F", "=", 
   RowBox[{
    RowBox[{"t", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", "^", "3"}], "+", 
       RowBox[{"y", "^", "3"}], "+", 
       RowBox[{"z", "^", "3"}]}], ")"}]}], "-", 
    RowBox[{"3", " ", "x", " ", "y", " ", "z"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"P", "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"-", "1"}], ",", "0"}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"gradP", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Grad", "[", 
      RowBox[{"F", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "/.", " ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], "->", "P"}], "]"}]}], ")"}],
    "//", "Simplify"}]}], "\n", 
 RowBox[{"L", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"gradP", ".", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ")"}], "//", "Expand"}], "//",
    "Simplify"}]}], "\n", 
 RowBox[{"Factor", "[", "L", "]"}]}], "Input",
 CellChangeTimes->{{3.981355427893486*^9, 3.981355427895956*^9}},
 CellLabel->
  "In[112]:=",ExpressionUUID->"c4e39567-aeae-4cf9-892d-32ba114813c8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"3", " ", "t"}], ",", 
   RowBox[{"3", " ", "t"}], ",", "3"}], "}"}]], "Output",
 CellChangeTimes->{3.9813554288149033`*^9},
 CellLabel->
  "Out[115]=",ExpressionUUID->"c50dc0a0-f86e-42ee-ac29-9d5fee423047"],

Cell[BoxData[
 RowBox[{"3", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"t", " ", 
     RowBox[{"(", 
      RowBox[{"x", "+", "y"}], ")"}]}], "+", "z"}], ")"}]}]], "Output",
 CellChangeTimes->{3.981355428816194*^9},
 CellLabel->
  "Out[116]=",ExpressionUUID->"c70557d3-47a5-41b9-a787-c1fa5db6dd60"],

Cell[BoxData[
 RowBox[{"3", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"t", " ", "x"}], "+", 
    RowBox[{"t", " ", "y"}], "+", "z"}], ")"}]}]], "Output",
 CellChangeTimes->{3.981355428817049*^9},
 CellLabel->
  "Out[117]=",ExpressionUUID->"09f2534f-7c92-41dd-aa75-c34fe6d007fa"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Coefficient", "[", 
     RowBox[{"L", ",", "x"}], "]"}], ",", 
    RowBox[{"Coefficient", "[", 
     RowBox[{"L", ",", "y"}], "]"}], ",", 
    RowBox[{"Coefficient", "[", 
     RowBox[{"L", ",", "z"}], "]"}]}], "}"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.981355434304243*^9, 3.981355434306902*^9}},
 CellLabel->
