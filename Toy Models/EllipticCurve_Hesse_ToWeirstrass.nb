Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "X", ",", "Y", ",", "Z", ",", "Minv", ",", "xyzInNew", ",", "Fnew", ",", 
     "aff"}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Your", " ", "linear", " ", "map", " ", 
      RowBox[{"is", ":", "X"}]}], "=", 
     RowBox[{"l1", "=", "x"}]}], ",", 
    RowBox[{"Y", "=", 
     RowBox[{"l2", "=", "y"}]}], ",", 
    RowBox[{"Z", "=", 
     RowBox[{"l3", "=", 
      RowBox[{"L", "=", 
       RowBox[{"3", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"t", " ", "x"}], "+", 
          RowBox[{"t", " ", "y"}], "+", "z"}], ")"}]}]}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"So", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"X", ",", "Y", ",", "Z"}], ")"}], "^", "T"}]}], "=", 
    RowBox[{
     RowBox[{"M", ".", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", ",", "y", ",", "z"}], ")"}], "^", "T"}]}], " ", "with", 
     " ", "M", " ", "as", " ", "you", " ", 
     RowBox[{"built", "."}]}]}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Minv", "=", 
    RowBox[{
     RowBox[{"Inverse", "[", "M", "]"}], "//", "Simplify"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "express", " ", "old", " ", "coordinates", " ", "in", " ", "terms", " ", 
    "of", " ", "new"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xyzInNew", "=", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], "->", 
       RowBox[{"(", 
        RowBox[{"Minv", ".", 
         RowBox[{"{", 
          RowBox[{"X", ",", "Y", ",", "Z"}], "}"}]}], ")"}]}], "]"}], "//", 
     "Simplify"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "substitute", " ", "into", " ", "the", " ", "original", " ", "cubic", " ", 
    "and", " ", "clear", " ", "denominators"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Fnew", "=", 
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{"F", "/.", " ", "xyzInNew"}], "]"}], "//", "Simplify"}]}], 
   ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"dehomogenize", ":", 
     RowBox[{"take", " ", "affine", " ", "patch", " ", "Z"}]}], "=", "1"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aff", "=", 
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{"Fnew", "/.", " ", 
       RowBox[{"Z", "->", "1"}]}], "]"}], "//", "Simplify"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"aff", "//", "Factor"}]}], "Input",
 CellChangeTimes->{{3.981355474143589*^9, 3.9813554741460752`*^9}},
 CellLabel->
  "In[132]:=",ExpressionUUID->"1b9d67d6-f2c8-4897-8980-b3a040a7d96e"],

