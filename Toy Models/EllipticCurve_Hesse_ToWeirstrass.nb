        RowBox[{"(", 
         RowBox[{
          RowBox[{"t", " ", "x"}], "+", 
          RowBox[{"t", " ", "y"}], "+", "z"}], ")"}]}]}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"So", " ", 
