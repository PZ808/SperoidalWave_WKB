Cell[CellGroupData[{

Cell["Brute force Picard Fuchs Derivation", "Section",
 CellChangeTimes->{{3.981359979669758*^9, 
  3.981359986342164*^9}},ExpressionUUID->"d4ce4e0e-f659-45ba-8e43-\
bf96cca50433"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "x", ",", "t", ",", "y", ",", "B", ",", "Cc", ",", "Q", ",", "Qt", ",", 
     "Qtt", ",", "P", ",", "Ek", ",", "a", ",", "solA", ",", "Rem", ",", 
     "solBC"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"The", " ", "\"\<normal form\>\"", " ", 
     RowBox[{"cubic", ":", 
      RowBox[{"y", "^", "2"}]}]}], "=", 
    RowBox[{"Q", 
     RowBox[{"(", 
      RowBox[{"x", ",", "t"}], ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Q", "=", 
   RowBox[{
    RowBox[{"t", " ", 
     RowBox[{"x", "^", "3"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "4"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"4", " ", 
        RowBox[{"t", "^", "3"}]}]}], ")"}], " ", 
     RowBox[{"x", "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "3"}], ")"}], " ", 
     RowBox[{"t", "^", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"t", "^", "3"}], "-", "1"}], ")"}], " ", "x"}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "27"}], ")"}], " ", "t", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"t", "^", "3"}], "-", "1"}], ")"}], "^", "2"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Qt", "=", 
   RowBox[{"D", "[", 
    RowBox[{"Q", ",", "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Qtt", "=", 
    RowBox[{"D", "[", 
     RowBox[{"Q", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Treat", " ", "y", " ", "as", " ", "y", 
     RowBox[{"(", "t", ")"}], " ", "for", " ", "differentiation"}], ",", 
    RowBox[{
     RowBox[{"then", " ", "impose", " ", 
      RowBox[{"y", "^", "2"}]}], "=", 
     RowBox[{
      RowBox[{"Q", " ", "via", " ", "derivative", " ", 
       RowBox[{"identities", ":", 
        RowBox[{"2", " ", "y", " ", "y_t"}]}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Q_t", " ", "2", " ", 
         RowBox[{"y_t", "^", "2"}]}], "+", 
        RowBox[{"2", " ", "y", " ", "y_tt"}]}], "=", "Q_tt"}]}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rulesY", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "[", "t", "]"}], "->", "y"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", "1", "]"}], "[", "y", "]"}], "[", "t", 
        "]"}], "->", 
       RowBox[{"Qt", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "y"}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", "2", "]"}], "[", "y", "]"}], "[", "t", 
        "]"}], "->", 
       RowBox[{
        RowBox[{"Qtt", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "y"}], ")"}]}], "-", 
        RowBox[{
         RowBox[{"Qt", "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"4", " ", 
           RowBox[{"y", "^", "3"}]}], ")"}]}]}]}]}], "}"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"omega", "=", 
     RowBox[{"dx", "/", "y"}]}], ",", 
    RowBox[{
    "so", " ", "we", " ", "track", " ", "only", " ", "its", " ", 
     "coefficient", " ", 
     RowBox[{"1", "/", "y"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f0", "=", 
   RowBox[{"1", "/", 
    RowBox[{"y", "[", "t", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f1", "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"f0", ",", "t"}], "]"}], "//", "Simplify"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f2", "=", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"f0", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "//", "Simplify"}]}], ";"}], 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"eta", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"d", "^", "2"}], "/", 
         RowBox[{"dt", "^", "2"}]}], "+", 
        RowBox[{"B", " ", 
         RowBox[{"d", "/", "dt"}]}], "+", "C"}], ")"}], " ", "omega"}], "=", 
     RowBox[{">", 
      RowBox[{"coefficient", " ", "times", " ", "dx"}]}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"etaCoeff", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"f2", "+", 
        RowBox[{"B", " ", "f1"}], "+", 
        RowBox[{"Cc", " ", "f0"}]}], ")"}], "/.", " ", "rulesY"}], "]"}]}], 
   ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Put", " ", "eta", " ", "in", " ", "the", " ", "form", " ", "P", 
     RowBox[{
      RowBox[{"(", "x", ")"}], "/", 
      RowBox[{"y", "^", "5"}]}], " ", "dx", " ", "by", " ", "multiplying", 
     " ", "through", " ", "by", " ", 
     RowBox[{"y", "^", "5"}], " ", "and", " ", "using", " ", 
     RowBox[{"y", "^", "2"}]}], "=", "Q"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"P", "=", 
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"etaCoeff", "*", 
          RowBox[{"y", "^", "5"}]}], ")"}], "//.", " ", 
        RowBox[{
         RowBox[{"y", "^", "2"}], "->", "Q"}]}], "//.", 
       RowBox[{
        RowBox[{"y", "^", "4"}], "->", 
        RowBox[{"Q", "^", "2"}]}]}], "]"}], "//", "Simplify"}]}], ";"}], "\n",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Exact", " ", 
     RowBox[{"forms", ":", 
      RowBox[{"d", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "^", "k"}], "/", 
         RowBox[{"y", "^", "3"}]}], ")"}]}]}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"[", 
       RowBox[{
        RowBox[{"k", " ", 
         RowBox[{"x", "^", 
          RowBox[{"(", 
           RowBox[{"k", "-", "1"}], ")"}]}], " ", "Q"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"3", "/", "2"}], ")"}], " ", 
         RowBox[{"x", "^", "k"}], " ", "Q_x"}]}], "]"}], "/", 
      RowBox[{"y", "^", "5"}]}], " ", "dx", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"since", " ", "y_x"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Q_x", "/", 
          RowBox[{"(", 
           RowBox[{"2", "y"}], ")"}]}], " ", "and", " ", 
         RowBox[{"y", "^", "2"}]}], "=", "Q"}]}], ")"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Qx", "=", 
   RowBox[{"D", "[", 
    RowBox[{"Q", ",", "x"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ek", "[", "k_", "]"}], ":=", 
    RowBox[{"Expand", "[", 
     RowBox[{
      RowBox[{"k", " ", 
       RowBox[{"x", "^", 
        RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}]}], " ", "Q"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"3", "/", "2"}], ")"}], " ", 
       RowBox[{"x", "^", "k"}], " ", "Qx"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
      "Solve", " ", "for", " ", "a_k", " ", "so", " ", "that", " ", "degrees",
        " ", 
       RowBox[{"x", "^", "6"}]}], ".."}], 
     RowBox[{"x", "^", "2"}], " ", "cancel", " ", "in", " ", "P"}], "-", 
    RowBox[{"Sum", " ", "a_k", " ", "Ek", 
     RowBox[{"(", "k", ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aVars", "=", 
    RowBox[{"Array", "[", 
     RowBox[{"a", ",", "5", ",", "0"}], "]"}]}], ";"}], "               ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"a", "[", "0", "]"}], ",", "...", ",", 
    RowBox[{"a", "[", "4", "]"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"expr", "=", 
    RowBox[{"Expand", "[", 
     RowBox[{"P", "-", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "[", "k", "]"}], " ", 
         RowBox[{"Ek", "[", "k", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "4"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqsA", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"expr", ",", "x", ",", "n"}], "]"}], "==", "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "2", ",", "6"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solA", "=", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{"eqsA", ",", "aVars"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Rem", "=", 
    RowBox[{"Expand", "[", 
     RowBox[{"expr", "/.", " ", "solA"}], "]"}]}], ";"}], "         ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"should", " ", "be", " ", "degree"}], "<=", 
    RowBox[{"1", " ", "in", " ", "x"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Now", " ", "set", " ", "remaining", " ", "two", " ", "coefficients", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", "^", "1"}], " ", "and", " ", 
       RowBox[{"x", "^", "0"}]}], ")"}], " ", "to", " ", "zero", " ", "to", 
     " ", "solve", " ", "for", " ", "B"}], ",", "C"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"eqsBC", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"Rem", ",", "x", ",", "1"}], "]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"Rem", ",", "x", ",", "0"}], "]"}], "==", "0"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solBC", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{"eqsBC", ",", 
        RowBox[{"{", 
         RowBox[{"B", ",", "Cc"}], "}"}]}], "]"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"t", "!=", "0"}], "&&", 
        RowBox[{
         RowBox[{"t", "^", "3"}], "!=", "1"}]}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"solBC", "//", "FullSimplify"}]}], "Input",
 CellChangeTimes->{{3.981355158703693*^9, 3.981355181073193*^9}, 
   3.9813552181511087`*^9, 3.981356226664435*^9, {3.981356290849697*^9, 
