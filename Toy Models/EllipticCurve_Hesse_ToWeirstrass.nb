Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["1", "432"]}], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "t"}], ")"}], "3"], " ", "t", " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"1", "+", "t", "+", 
