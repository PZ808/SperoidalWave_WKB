       RowBox[{
        RowBox[{"t", "^", "3"}], "-", "1"}], ")"}], " ", "x"}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "27"}], ")"}], " ", "t", " ", 
