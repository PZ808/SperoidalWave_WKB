     RowBox[{"built", "."}]}]}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Minv", "=", 
    RowBox[{
     RowBox[{"Inverse", "[", "M", "]"}], "//", "Simplify"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "express", " ", "old", " ", "coordinates", " ", "in", " ", "terms", " ", 
    "of", " ", "new"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xyzInNew", "=", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], "->", 
       RowBox[{"(", 
        RowBox[{"Minv", ".", 
         RowBox[{"{", 
