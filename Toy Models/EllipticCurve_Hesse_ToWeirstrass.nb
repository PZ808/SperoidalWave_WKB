}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"l1", "=", "x"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"l2", "=", "y"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"l3", "=", "L"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"M", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"l1", ",", "x"}], "]"}], ",", 
        RowBox[{"Coefficient", "[", 
         RowBox[{"l1", ",", "y"}], "]"}], ",", 
        RowBox[{"Coefficient", "[", 
         RowBox[{"l1", ",", "z"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"l2", ",", "x"}], "]"}], ",", 
        RowBox[{"Coefficient", "[", 
         RowBox[{"l2", ",", "y"}], "]"}], ",", 
        RowBox[{"Coefficient", "[", 
         RowBox[{"l2", ",", "z"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Coefficient", "[", 
         RowBox[{"l3", ",", "x"}], "]"}], ",", 
        RowBox[{"Coefficient", "[", 
         RowBox[{"l3", ",", "y"}], "]"}], ",", 
        RowBox[{"Coefficient", "[", 
         RowBox[{"l3", ",", "z"}], "]"}]}], "}"}]}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Det", "[", "M", "]"}], "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.981355439182521*^9, 3.981355439185266*^9}},
 CellLabel->
  "In[119]:=",ExpressionUUID->"db9fb2e7-5f4e-43aa-a194-2832cc94fb2b"],

Cell[BoxData["3"], "Output",
